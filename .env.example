DISCORD_TOKEN=replace_with_bot_token
DISCORD_APPLICATION_ID=123456789012345678
# テスト用ギルドにのみコマンド登録（グローバル登録は行わない）
DISCORD_GUILD_IDS=123456789012345678
RECORDINGS_DIR=./recordings
MAX_DURATION_MS=900000
MAX_SESSION_BYTES=536870912
MAX_PARTICIPANTS=10
MAX_PENDING_BYTES=4194304
RECONNECT_TIMEOUT_MS=15000
SEGMENT_GAP_MS=250
# 詳細診断はmetadata.jsonへ保存（コンソールにID・音声・秘密情報を出さない）
RECORDING_DIAGNOSTICS=false
# 停止後の非破壊分類（変更後はBotを再起動）。試験用初期値であり最適値ではない。
VAD_ENABLED=true
VAD_POSITIVE_THRESHOLD=0.40
VAD_NEGATIVE_THRESHOLD=0.30
VAD_MIN_SPEECH_MS=100
VAD_REDEMPTION_MS=200
VAD_PRE_SPEECH_PAD_MS=100
# 全ギルドで共有するWorker数：1〜4
VAD_MAX_CONCURRENCY=1

# 停止後の手動文字起こし。falseのままならdry-runのみ（Bot起動時には送信しない）
STT_ENABLED=false
STT_PROVIDER=azure-mai
STT_MODEL=MAI-Transcribe-2
STT_LANGUAGE=ja
STT_STYLE=verbatim
STT_TIMESTAMPS=segment
# JSON配列。専門用語はAzureへ送信される
STT_PHRASES_JSON=[]
# 既定はspeechのみ。聴取確認後の再実験でspeech,unclassified等へ変更可能
STT_CLASSES=speech
STT_CHUNK_SECONDS=20
STT_CHUNK_GAP_MS=1000
STT_MAX_CONCURRENCY=2
# 各CLI実行の上限。リトライを含む実リクエスト数・送信音声秒数
STT_MAX_REQUESTS=100
STT_MAX_AUDIO_SECONDS=900
STT_MAX_RETRIES=2
STT_TIMEOUT_MS=120000
# 例: https://your-resource.cognitiveservices.azure.com （空欄は実送信不可）
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_KEY=

# LLMへの文字起こし・ユーザーID・時刻送信も明示的に有効化する
MINUTES_ENABLED=false
MINUTES_PROVIDER=openai
MINUTES_MODEL=gpt-5.6-terra
MINUTES_MAX_RETRIES=2
MINUTES_TIMEOUT_MS=120000
MINUTES_MAX_INPUT_CHARS=200000
MINUTES_MAX_OUTPUT_TOKENS=16000
OPENAI_API_KEY=
